{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gacc.dev/schemas/angular-frontend/migration-plan.schema.json",
  "title": "Angular Karma-to-Vitest Executable Migration Plan (Phase 2)",
  "type": "object",
  "required": [
    "schemaVersion",
    "createdAt",
    "basedOnDiagnosis",
    "projectName",
    "tasks",
    "verificationCommand",
    "approval"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "basedOnDiagnosis": {
      "type": "string",
      "const": ".migration-artifacts/karma-to-vitest/01-diagnosis-report.json"
    },
    "projectName": {
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "order",
          "category",
          "title",
          "targetFiles",
          "actions",
          "verification",
          "status"
        ],
        "properties": {
          "id": { "type": "string" },
          "order": { "type": "integer", "minimum": 1 },
          "category": {
            "type": "string",
            "enum": [
              "dependencies",
              "angular-config",
              "tsconfig",
              "cleanup",
              "spec-transform",
              "verification"
            ]
          },
          "title": { "type": "string" },
          "targetFiles": {
            "type": "array",
            "items": { "type": "string" }
          },
          "actions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "verification": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["PENDING", "IN_PROGRESS", "COMPLETED"]
          }
        }
      }
    },
    "verificationCommand": {
      "type": "string"
    },
    "approval": {
      "type": "object",
      "required": ["status", "reviewer", "approvedAt"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PENDING", "APPROVED", "REJECTED"]
        },
        "reviewer": { "type": ["string", "null"] },
        "approvedAt": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}
