{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gacc.dev/schemas/angular-frontend/migration-plan.schema.json",
  "title": "Angular Karma-to-Vitest Master Migration Plan Index (Phase 2)",
  "type": "object",
  "required": [
    "schemaVersion",
    "planMode",
    "createdAt",
    "basedOnDiagnosis",
    "diagnosisHash",
    "projectName",
    "coexistenceStrategy",
    "totalSpecFiles",
    "totalComplexityScore",
    "phases",
    "generatedFiles"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2.0.0"
    },
    "planMode": {
      "type": "string",
      "const": "multi-phase"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "basedOnDiagnosis": {
      "type": "string",
      "const": ".migration-artifacts/karma-to-vitest/01-diagnosis-report.json"
    },
    "diagnosisHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{16}$"
    },
    "projectName": {
      "type": "string"
    },
    "angularProject": {
      "type": ["string", "null"]
    },
    "coexistenceStrategy": {
      "type": "object",
      "required": [
        "mode",
        "karmaTarget",
        "vitestTarget",
        "vitestTsConfig",
        "specIsolation"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "const": "parallel-angular-target"
        },
        "karmaTarget": {
          "type": "string"
        },
        "vitestTarget": {
          "type": "string"
        },
        "vitestTsConfig": {
          "type": "string"
        },
        "specIsolation": {
          "type": "string",
          "const": "include-exclude-config"
        }
      }
    },
    "totalSpecFiles": {
      "type": "integer",
      "minimum": 0
    },
    "totalComplexityScore": {
      "type": "integer",
      "minimum": 0
    },
    "phases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "phaseId",
          "order",
          "kind",
          "title",
          "dependsOnPhase",
          "planFile",
          "markdownFile",
          "specCount",
          "totalComplexityScore",
          "status"
        ],
        "properties": {
          "phaseId": {
            "type": "string",
            "pattern": "^phase-[0-9]{2}-[a-z0-9-]+$"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "type": "string",
            "enum": ["coexistence-setup", "spec-batch", "cutover-cleanup"]
          },
          "complexityTier": {
            "type": ["string", "null"],
            "enum": ["low", "medium", "high", null]
          },
          "title": {
            "type": "string"
          },
          "dependsOnPhase": {
            "type": ["string", "null"]
          },
          "planFile": {
            "type": "string"
          },
          "markdownFile": {
            "type": "string"
          },
          "specCount": {
            "type": "integer",
            "minimum": 0
          },
          "totalComplexityScore": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "IN_PROGRESS", "COMPLETED"]
          }
        }
      }
    },
    "generatedFiles": {
      "type": "object",
      "required": ["masterJson", "masterMarkdown", "phaseFiles"],
      "properties": {
        "masterJson": { "type": "string" },
        "masterMarkdown": { "type": "string" },
        "phaseFiles": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
