{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gacc.dev/schemas/angular-frontend/diagnosis-report.schema.json",
  "title": "Angular Karma-to-Vitest Diagnosis Report (Phase 1)",
  "type": "object",
  "required": [
    "schemaVersion",
    "diagnosisHash",
    "evaluatedAt",
    "projectPath",
    "status",
    "recommendedStrategy",
    "strategyReasons",
    "officialSchematic",
    "summary",
    "metrics",
    "findings",
    "complexityBreakdown",
    "detected",
    "complexitySignals",
    "requirements",
    "blockers",
    "specInventory",
    "roadmap",
    "generatedFiles",
    "approval"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.3.0"
    },
    "diagnosisHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{16}$"
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "projectPath": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["READY", "BLOCKED"]
    },
    "recommendedStrategy": {
      "type": "string",
      "enum": [
        "UPGRADE_FIRST",
        "OFFICIAL_SCHEMATIC_SUFFICIENT",
        "HYBRID_SCHEMATIC_PLUS_AGENT"
      ]
    },
    "strategyReasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "officialSchematic": {
      "type": "object",
      "required": ["command", "sufficient", "notes"],
      "properties": {
        "command": {
          "type": "string",
          "const": "ng g @schematics/angular:refactor-jasmine-vitest"
        },
        "sufficient": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "summary": {
      "type": "string"
    },
    "metrics": {
      "type": "object",
      "required": ["specFileCount", "angularProjectCount", "lowComplexityPct", "needsReviewPct"],
      "properties": {
        "specFileCount": { "type": "integer", "minimum": 0 },
        "angularProjectCount": { "type": "integer", "minimum": 0 },
        "lowComplexityPct": { "type": "integer", "minimum": 0, "maximum": 100 },
        "needsReviewPct": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "findings": {
      "type": "object",
      "required": ["jasmineApiUsages", "fakeAsyncTickUsages", "customKarmaConfigs", "dependenciesToReview"],
      "properties": {
        "jasmineApiUsages": { "type": "integer", "minimum": 0 },
        "fakeAsyncTickUsages": { "type": "integer", "minimum": 0 },
        "customKarmaConfigs": { "type": "integer", "minimum": 0 },
        "dependenciesToReview": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "complexityBreakdown": {
      "type": "object",
      "required": ["low", "medium", "high"],
      "properties": {
        "low": {
          "type": "object",
          "required": ["count", "percentage"],
          "properties": {
            "count": { "type": "integer", "minimum": 0 },
            "percentage": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        },
        "medium": {
          "type": "object",
          "required": ["count", "percentage"],
          "properties": {
            "count": { "type": "integer", "minimum": 0 },
            "percentage": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        },
        "high": {
          "type": "object",
          "required": ["count", "percentage"],
          "properties": {
            "count": { "type": "integer", "minimum": 0 },
            "percentage": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        }
      }
    },
    "detected": {
      "type": "object",
      "required": ["angularCoreVersion", "nodeVersion", "testBuilder", "specFileCount"],
      "properties": {
        "projectName": { "type": ["string", "null"] },
        "selectedAngularProject": { "type": ["string", "null"] },
        "angularCoreVersion": { "type": ["string", "null"] },
        "angularCliVersion": { "type": ["string", "null"] },
        "nodeVersion": { "type": "string" },
        "testBuilder": { "type": ["string", "null"] },
        "buildBuilder": { "type": ["string", "null"] },
        "angularProjectCount": { "type": "integer", "minimum": 0 },
        "testTargetCount": { "type": "integer", "minimum": 0 },
        "hasKarmaDeps": { "type": "boolean" },
        "hasJasmineDeps": { "type": "boolean" },
        "hasKarmaConf": { "type": "boolean" },
        "specFileCount": { "type": "integer", "minimum": 0 }
      }
    },
    "complexitySignals": {
      "type": "object",
      "required": ["customKarmaConfig", "multiProjectTestTargets", "complexSpecPatterns"],
      "properties": {
        "customKarmaConfig": { "type": "boolean" },
        "customKarmaFeatures": {
          "type": "array",
          "items": { "type": "string" }
        },
        "multiProjectTestTargets": { "type": "boolean" },
        "hasCustomTargetOptions": { "type": "boolean" },
        "complexSpecPatterns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "complexSpecFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "patterns"],
            "properties": {
              "file": { "type": "string" },
              "patterns": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "requirements": {
      "type": "object",
      "required": ["minStableAngularVersion", "targetBuilder", "targetRunner"],
      "properties": {
        "minStableAngularVersion": { "type": "string", "const": "21.0.0" },
        "requiredNodeRange": { "type": "string" },
        "targetBuilder": { "type": "string", "const": "@angular/build:unit-test" },
        "targetRunner": { "type": "string", "const": "vitest" }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message", "remediation"],
        "properties": {
          "code": { "type": "string" },
          "severity": { "type": "string", "enum": ["error", "warning"] },
          "message": { "type": "string" },
          "remediation": { "type": "string" }
        }
      }
    },
    "specInventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "jasminePatterns", "jasmineApiCount", "fakeAsyncTickCount", "complexity", "complexityScore"],
        "properties": {
          "file": { "type": "string" },
          "jasminePatterns": {
            "type": "array",
            "items": { "type": "string" }
          },
          "jasmineApiCount": { "type": "integer", "minimum": 0 },
          "fakeAsyncTickCount": { "type": "integer", "minimum": 0 },
          "complexity": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "complexityScore": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "expectedOutcome": {
            "type": "string",
            "enum": ["automatically_migrated", "requires_review", "manual_migration"]
          }
        }
      }
    },
    "roadmap": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "phase", "description", "state"],
        "properties": {
          "step": { "type": "integer", "minimum": 0 },
          "phase": { "type": "string" },
          "description": { "type": "string" },
          "state": { "type": "string", "enum": ["BLOCKING", "LOCKED", "COMPLETED", "PENDING"] }
        }
      }
    },
    "generatedFiles": {
      "type": "object",
      "required": ["json", "markdown", "html"],
      "properties": {
        "json": { "type": "string" },
        "markdown": { "type": "string" },
        "html": { "type": "string" }
      }
    },
    "approval": {
      "type": "object",
      "required": ["status", "reviewer", "approvedAt"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PENDING", "APPROVED", "REJECTED"]
        },
        "reviewer": { "type": ["string", "null"] },
        "approvedAt": { "type": ["string", "null"] },
        "mode": {
          "type": ["string", "null"],
          "enum": ["manual-json", "chat-confirmed", null]
        },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}
