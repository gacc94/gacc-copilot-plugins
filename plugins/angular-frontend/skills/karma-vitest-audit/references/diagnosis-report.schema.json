{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gacc.dev/schemas/angular-frontend/diagnosis-report.schema.json",
  "title": "Angular Karma-to-Vitest Diagnosis Report (Phase 1)",
  "type": "object",
  "required": [
    "schemaVersion",
    "evaluatedAt",
    "projectPath",
    "status",
    "recommendedStrategy",
    "strategyReasons",
    "officialSchematic",
    "summary",
    "detected",
    "complexitySignals",
    "requirements",
    "blockers",
    "specInventory",
    "approval"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.1.0"
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "projectPath": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["READY", "BLOCKED"]
    },
    "recommendedStrategy": {
      "type": "string",
      "enum": [
        "UPGRADE_FIRST",
        "OFFICIAL_SCHEMATIC_SUFFICIENT",
        "HYBRID_SCHEMATIC_PLUS_AGENT"
      ]
    },
    "strategyReasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "officialSchematic": {
      "type": "object",
      "required": ["command", "sufficient", "notes"],
      "properties": {
        "command": {
          "type": "string",
          "const": "ng g @schematics/angular:refactor-jasmine-vitest"
        },
        "sufficient": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "summary": {
      "type": "string"
    },
    "detected": {
      "type": "object",
      "required": [
        "angularCoreVersion",
        "nodeVersion",
        "testBuilder",
        "specFileCount"
      ],
      "properties": {
        "projectName": { "type": ["string", "null"] },
        "angularCoreVersion": { "type": ["string", "null"] },
        "angularCliVersion": { "type": ["string", "null"] },
        "nodeVersion": { "type": "string" },
        "testBuilder": { "type": ["string", "null"] },
        "testTargetCount": { "type": "integer", "minimum": 0 },
        "hasKarmaDeps": { "type": "boolean" },
        "hasJasmineDeps": { "type": "boolean" },
        "hasKarmaConf": { "type": "boolean" },
        "specFileCount": { "type": "integer", "minimum": 0 }
      }
    },
    "complexitySignals": {
      "type": "object",
      "required": [
        "customKarmaConfig",
        "multiProjectTestTargets",
        "complexSpecPatterns"
      ],
      "properties": {
        "customKarmaConfig": { "type": "boolean" },
        "customKarmaFeatures": {
          "type": "array",
          "items": { "type": "string" }
        },
        "multiProjectTestTargets": { "type": "boolean" },
        "hasCustomTargetOptions": { "type": "boolean" },
        "complexSpecPatterns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "complexSpecFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "patterns"],
            "properties": {
              "file": { "type": "string" },
              "patterns": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "requirements": {
      "type": "object",
      "required": ["minStableAngularVersion", "targetBuilder", "targetRunner"],
      "properties": {
        "minStableAngularVersion": { "type": "string", "const": "21.0.0" },
        "requiredNodeRange": { "type": "string" },
        "targetBuilder": {
          "type": "string",
          "const": "@angular/build:unit-test"
        },
        "targetRunner": { "type": "string", "const": "vitest" }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message", "remediation"],
        "properties": {
          "code": { "type": "string" },
          "severity": { "type": "string", "enum": ["error", "warning"] },
          "message": { "type": "string" },
          "remediation": { "type": "string" }
        }
      }
    },
    "specInventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "jasminePatterns", "complexity"],
        "properties": {
          "file": { "type": "string" },
          "jasminePatterns": {
            "type": "array",
            "items": { "type": "string" }
          },
          "complexity": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "required": ["status", "reviewer", "approvedAt"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PENDING", "APPROVED", "REJECTED"]
        },
        "reviewer": { "type": ["string", "null"] },
        "approvedAt": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}
