{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gacc.dev/schemas/angular-frontend/migration-rules.schema.json",
  "title": "Declarative Migration Rules Catalog (migration-rules)",
  "type": "object",
  "required": ["schemaVersion", "sourceFramework", "targetFramework", "rules"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "sourceFramework": {
      "type": "string"
    },
    "targetFramework": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "scope",
          "category",
          "treatment",
          "signalBucket",
          "detectionPattern",
          "safetyCriteria",
          "examples"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^RULE-[A-Z]+-[0-9]{3}$"
          },
          "name": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": ["spec", "karma-config", "angular-config"]
          },
          "category": {
            "type": "string",
            "enum": [
              "ast_transformation",
              "type_transformation",
              "semantic_transformation",
              "configuration_migration"
            ]
          },
          "treatment": {
            "type": "string",
            "enum": ["automatically_migrated", "requires_review", "manual_migration"]
          },
          "signalBucket": {
            "type": "string",
            "enum": ["jasmine_api", "async_timer", "complex_spec", "high_risk_config"]
          },
          "minimumComplexity": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "detectionPattern": {
            "type": "string"
          },
          "safetyCriteria": {
            "type": "string",
            "minLength": 10
          },
          "examples": {
            "type": "object",
            "required": ["input", "expectedOutput"],
            "properties": {
              "input": { "type": "string" },
              "expectedOutput": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
